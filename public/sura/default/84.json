":"يَا أَيُّهَا","translation":{"en":"O","bn":"হে","trl":"yāayyuhā"}},{"id":"86433","wId":75977,"verse_key":"84:6","char_type":"word","code":"&#xfb72;","page":"589","audio":"/084_006_002.mp3","text":"الْإِنْسَانُ","translation":{"en":"mankind","bn":"মানুষ","trl":"l-insānu"}},{"id":"86434","wId":75978,"verse_key":"84:6","char_type":"word","code":"&#xfb73;","page":"589","audio":"/084_006_003.mp3","text":"إِنَّكَ","translation":{"en":"Indeed, you","bn":"নিশ্চয়ই তুমি","trl":"innaka"}},{"id":"86435","wId":75979,"verse_key":"84:6","char_type":"word","code":"&#xfb74;","page":"589","audio":"/084_006_004.mp3","text":"كَادِحٌ","translation":{"en":"(are) laboring","bn":"পরিশ্রমকারী","trl":"kādiḥun"}},{"id":"86436","wId":75980,"verse_key":"84:6","char_type":"word","code":"&#xfb75;","page":"589","audio":"/084_006_005.mp3","text":"إِلَىٰ","translation":{"en":"to","bn":"দিকে","trl":"ilā"}},{"id":"86437","wId":75981,"verse_key":"84:6","char_type":"word","code":"&#xfb76;","page":"589","audio":"/084_006_006.mp3","text":"رَبِّكَ","translation":{"en":"your Lord","bn":"তোমার রবের","trl":"rabbika"}},{"id":"86438","wId":75982,"verse_key":"84:6","char_type":"word","code":"&#xfb77;","page":"589","audio":"/084_006_007.mp3","text":"كَدْحًا","translation":{"en":"(with) exertion","bn":"কঠোর পরিশ্রম","trl":"kadḥan"}},{"id":"86439","wId":75983,"verse_key":"84:6","char_type":"word","code":"&#xfb78;","page":"589","audio":"/084_006_008.mp3","text":"فَمُلَاقِيهِ","translation":{"en":"and you (will) meet Him","bn":"অতঃপর তাঁর (সাথে) সাক্ষাত করবে","trl":"famulāqīhi"}},{"id":"86440","code":"&#xfb79;","code_v3":"&#xa006;","verse_key":"84:6","char_type":"end"}],"translation":{"bn":"হে মানবসকল! তোমরা কঠোর পরিশ্রম করতে থাক, তোমাদের আমাল অনুযায়ী তোমাদের রবের সাক্ষাত লাভ করবে, আর এটাতো অবশ্যম্ভাবি।","en":"O mankind, indeed you are laboring toward your Lord with [great] exertion and will meet it.","trl":"Ya ayyuha al-insanuinnaka kadihun ila rabbika kadhanfamulaqeeh"},"tajweed":{"annotations":[{"end":4,"rule"