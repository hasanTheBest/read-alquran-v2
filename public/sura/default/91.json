","start":55}]}},{"a_id":6057,"verse_key":"91:14","text":"فَكَذَّبُوهُ فَعَقَرُوهَا فَدَمْدَمَ عَلَيْهِمْ رَبُّهُم بِذَنۢبِهِمْ فَسَوَّىٰهَا","sajdah":null,"juz":30,"page":595,"words":[{"id":"87293","wId":76664,"verse_key":"91:14","char_type":"word","code":"&#xfb8a;","page":"595","audio":"/091_014_001.mp3","text":"فَكَذَّبُوهُ","translation":{"en":"But they denied him","bn":"কিন্তু তারা তাকে  মিথ্যা ভাবলো","trl":"fakadhabūhu"}},{"id":"87294","wId":76665,"verse_key":"91:14","char_type":"word","code":"&#xfb8b;","page":"595","audio":"/091_014_002.mp3","text":"فَعَقَرُوهَا","translation":{"en":"and they hamstrung her","bn":"অতঃপর তারা তাকে  হত্যা করলো","trl":"faʿaqarūhā"}},{"id":"87295","wId":76666,"verse_key":"91:14","char_type":"word","code":"&#xfb8c;","page":"595","audio":"/091_014_003.mp3","text":"فَدَمْدَمَ","translation":{"en":"So destroyed","bn":"ফলে ধ্বংস করে দিলেন","trl":"fadamdama"}},{"id":"87296","wId":76667,"verse_key":"91:14","char_type":"word","code":"&#xfb8d;","page":"595","audio":"/091_014_004.mp3","text":"عَلَيْهِمْ","translation":{"en":"them","bn":"তাদেরকে","trl":"ʿalayhim"}},{"id":"87297","wId":76668,"verse_key":"91:14","char_type":"word","code":"&#xfb8e;","page":"595","audio":"/091_014_005.mp3","text":"رَبُّهُمْ","translation":{"en":"their Lord","bn":"তাদের রব","trl":"rabbuhum"}},{"id":"87298","wId":76669,"verse_key":"91:14","char_type":"word","code":"&#xfb8f;","page":"595","audio":"/091_014_006.mp3","text":"بِذَنْبِهِمْ","translation":{"en":"for their sin","bn":"তাদের পাপের জন্য","trl":"bidhanbihim"}},{"id":"87299","wId":76670,"verse_key":"91:14","char_type":"word","code":"&#xfb90;","page":"595","audio":"/091_014_007.mp3","text":"فَسَوَّاهَا","translation":{"en":"and leveled them","bn":"অতঃপর তাদেরকে (মাটি) সমান করে দিলেন","trl":"fasawwāhā"}},{"id":"87300","code":"&#xfb91;","code_v3":"&#xa014;","verse_key":"91:14","char_type":"end"}],"translation":{"bn":"কিন্তু তারা তাকে মিথ্যাবাদী বলল, অতঃপর ঐ উষ্ট্রিকে কেটে ফেলল। সুতরাং তাদের পাপের জন্য তাদের রাব্ব তাদেরকে সমূলে ধ্বংস করলেন, অতঃপর তাদেরকে ভূমিসাৎ করে ফেললেন,","en":"But they denied him and hamstrung her. So their Lord brought down upon them destruction for their sin and made it equal [upon all of them].","trl":"Fakaththaboohu faAAaqaroohafadamdama AAalayhim rabbuhum bithanbihim fasawwaha"},"tajweed":{"annotations":[{"end":59,"rule":"ikhfa_shafawi","start":55},{"end":64,"rule":"iqlab","start":62},{"end":79,"rule":"madd_2","start":78}]}},{"a_id":6058,"verse_key":"91:15","text":"وَلَا يَخَافُ عُقْبَٰهَا","sajdah":null,"juz":30,"page":595,"words":[{"id":"87301","wId":76671,"verse_key":"91:15","char_type":"word","code":"&#xfb92;","page":"595","audio":"/091_015_001.mp3","text":"وَلَا","translation":{"en":"And not","bn":"এবং না","trl":"walā"}},{"id":"87302","wId":76672,"verse_key":"91:15","char_type":"word","code":"&#xfb93;","page":"595","audio":"/091_015_002.mp3","text":"يَخَافُ","translation":{"en":"He fears","bn":"ভয় করেন তিনি","trl":"yakhāfu"}},{"id":"87303","wId":76673,"verse_key":"91:15","char_type":"word","code":"&#xfb94;","page":"595","audio":"/091_015_003.mp3","text":"عُقْبَاهَا","translation":{"en":"its consequences","bn":"তাঁর (কাজের) পরিণতির","trl":"ʿuq'bāhā"}},{"id":"87304","code":"&#xfb95;","code_v3":"&#xa015;","verse_key":"91:15","char_type":"end"}],"translation":{"bn":"আর তিনি ওর পরিণামকে ভয় করলেন না।","en":"And He does not fear the consequence thereof.","trl":"Wala yakhafu AAuqbaha"},"tajweed":{"annotations":[{"end":18,"rule":"qalqalah","start":16},{"end":21,"rule":"madd_2","start":20}]}}]}